
<div class="antd-outlined-label-group">
    <label class="antd-outlined-label" for="passwordField">@Label</label>
    <Input id="passwordField"
           Value="Value"
           ValueChanged="ValueChanged"
           ValueExpression="(() => Value)"
           Placeholder="@Placeholder"
           class="antd-outlined-input" />
</div>

@code {
    [Parameter] public string Label { get; set; } = "Þifre";
    [Parameter] public string Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Þifre";
}

<style>
    .antd-outlined-label-group {
        position: relative;
        margin: 16px 0;
    }

    .antd-outlined-label {
        position: absolute;
        top: -10px;
        left: 16px;
        background: #fff;
        padding: 0 4px;
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        color: #1C1B1F;
        z-index: 2;
        pointer-events: none;
    }

    .antd-outlined-input {
        width: 100%;
        border: 1px solid #79747E !important;
        border-radius: 4px !important;
        padding: 8px 8px 8px 8px !important;
        font-family: 'Poppins', sans-serif;
        font-size: 16px;
        color: #1C1B1F;
        box-sizing: border-box;
        background: #fff !important;
    }
</style>
