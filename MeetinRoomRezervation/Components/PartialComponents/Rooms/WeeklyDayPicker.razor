@using AntDesign
@using MeetinRoomReservation.Constants
@using MeetinRoomRezervation.Extensions

<div class="date-selector">
    <Space class="equal-space">
        @foreach (var date in Dates)
        {
            <Button Type="ButtonType.Default" @onclick="() => OnDateSelected(date)"
                class="@($"equal-button {(SelectedDate.Date == date.Date.Date ? "selected-date" : "")}")">
                @date.Label
            </Button>
        }
    </Space>
</div>

@code {
    [Parameter] public EventCallback<DateItem> DateSelected { get; set; }
    [Parameter] public EventCallback<DateItem> SelectedDateChanged { get; set; }
    [Parameter] public DateItem SelectedDate { get; set; }

    private readonly List<DateItem> Dates = Enumerable.Range(0, 5)
    .Select(i =>
    {
        var date = DateTime.UtcNow.ConvertToTimeZone(DateConstants.DefaultTimeZone).AddDays(i);
        string label = i switch
        {
            0 => "Bugün",
            1 => "Yarın",
            _ => GetShortDateLabel(date)
        };
        return new DateItem(label, date);
    })
    .ToList();

    private static string GetShortDateLabel(DateTime date)
    {
        var dayName = date.ToString("ddd", new System.Globalization.CultureInfo("tr-TR"));
        var dateStr = date.ToString("dd.MM", new System.Globalization.CultureInfo("tr-TR"));
        return $"{dateStr} {dayName}";
    }


    private async Task OnDateSelected(DateItem date)
    {
        SelectedDate = date;
        await SelectedDateChanged.InvokeAsync(date);
        await DateSelected.InvokeAsync(date);
    }

    public class DateItem
    {
        public string Label { get; }
        public DateTime Date { get; }
        public DateItem(string label, DateTime date) { Label = label; Date = date; }
    }
}
