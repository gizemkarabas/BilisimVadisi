<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- Critical FOUC prevention - Must be inline for zero delay -->
    <style>
        html {
            opacity: 0 !important;
            visibility: hidden !important
        }
    </style>
    <!-- Google Fonts - Optimized loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Preload critical font weights -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" as="style"
        onload="this.onload=null;this.rel='stylesheet'" />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" as="style"
        onload="this.onload=null;this.rel='stylesheet'" />

    <!-- Fallback for no-js -->
    <noscript>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap">
    </noscript>

    <!-- CSS Files - Critical first -->
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="_content/AntDesign/css/ant-design-blazor.css" />
    <link rel="stylesheet" href="MeetinRoomRezervation.styles.css" />

    <!-- FOUC prevention must load early -->
    <script src="js/fouc-prevention.js"></script>

    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <!-- Loading indicator -->
    <div id="blazor-loading" class="blazor-loading">
        <div class="spinner"></div>
    </div>

    <Routes @rendermode="InteractiveServer" />

    <script src="_framework/blazor.web.js"></script>
    <script src="js/css-loader.js"></script>
    <script src="js/cookieManager.js"></script>
    <script src="js/blazor-connection.js"></script>
</body>

</html>
