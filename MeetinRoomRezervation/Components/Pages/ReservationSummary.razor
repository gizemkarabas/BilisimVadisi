@page "/user/reservation-summary"
@using MeetinRoomReservation.Constants
@using MeetinRoomRezervation.Components.PartialComponents.Reservations
@using MeetinRoomRezervation.Components.PartialComponents.Shared
@using MeetinRoomRezervation.Constants
@using MeetinRoomRezervation.Models
@using MeetinRoomRezervation.Services.ReservationService
@using AntDesign
@using System.Globalization
@inject ReservationDto ReservationState
@inject IReservationService ReservationService
@inject IRoomService RoomService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject IMessageService MessageService

<BackPanel>
    <div class="reservation-header">Rezervasyonunuzu Onaylayın</div>
        <div class="reservation-card-center">
            @if (ReservationState.SelectedSlots.Any())
            {
                <div class="reservation-card">
                    <!-- Hata mesajı gösterimi -->
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div style="margin-bottom: 20px;">
                            <Alert Message="@errorMessage" Type="@AlertType.Error" ShowIcon="true" Closable="true"
                                   OnClose="() => errorMessage = string.Empty" />
                        </div>
                    }

                    <div class="slots-list">
                        @foreach (var slot in ReservationState.SelectedSlots)
                        {
                            <div style="background-color: #1890ff;text-align:left; color: white;width:100%; padding: 8px 16px; border-radius: 5px; min-width: 100px;">
                                @slot.StartTime.ToString("HH:mm") - @slot.EndTime.ToString("HH:mm")
                            </div>
                        }
                    </div>

                    <Summary Info=" new()
                             {
                                 Label1 = StringConstants.Location,
                                 Label2 = StringConstants.Saloon,
                                 Label3 = StringConstants.Date,
                                 Value1 = StringConstants.LocationName,
                                 Value2 = ReservationState.RoomName,
                                 Value3 = ReservationState.SelectedDate.ToString(DateConstants.DateTimeFormatWithDayName)
                             }" />

                <div style="margin-top: 16px; text-align:center;">
                    <b>Kullanıcı:</b>
                    @(ReservationState.User != null ? $"{ReservationState.User.FirstName} {ReservationState.User.LastName} ({ReservationState.User.Email})" : ReservationState.UserEmail)
                </div>

                    <h4 style="text-align:center; font-weight:700">
                        Toplam @ReservationState.SelectedSlots.Count Saat
                    </h4>

                    <div style="margin-top: 20px; text-align:center;">
                        <Button Type="ButtonType.Primary" OnClick="ConfirmReservation"
                                Style="width: 200px;" Shape="ButtonShape.Round" Loading="@isLoading">
                        @if (isLoading)
                            {
                                <span>Onaylanıyor...</span>
                            }
                            else
                            {
                                <span>Onayla</span>
                            }
                        </Button>
                    </div>

                    <div style="margin-top: 10px; text-align:center;">
                        <Button Type="ButtonType.Default" OnClick="GoBack" Style="width: 200px;" Disabled="@isLoading">Geri</Button>
                    </div>
                </div>
            }
            else
            {
                <Alert Message="Seçili saat bulunamadı." Type="@AlertType.Warning" ShowIcon="true" />
            }
        </div>
</BackPanel>

@code {
    private static readonly CultureInfo turkishCulture = new CultureInfo("tr-TR");
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"ReservationSummary - SelectedSlots count: {ReservationState?.SelectedSlots?.Count ?? 0}");

        if (ReservationState?.SelectedSlots != null)
        {
            foreach (var slot in ReservationState.SelectedSlots)
            {
                Console.WriteLine($"Summary slot: {slot.StartTime:HH:mm} - {slot.EndTime:HH:mm}");
            }
        }

        // Salon adı eksikse RoomId ile doldur
        if ((string.IsNullOrWhiteSpace(ReservationState.RoomName) || ReservationState.RoomName == "-") && !string.IsNullOrEmpty(ReservationState.RoomId))
        {
            var room = await RoomService.GetRoomByIdAsync(ReservationState.RoomId);
            if (room != null)
            {
                ReservationState.RoomName = room.Name;
                ReservationState.Room = room;
            }
        }
    }

    private async Task ConfirmReservation()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            Console.WriteLine($"ConfirmReservation - SelectedSlots count: {ReservationState?.SelectedSlots?.Count ?? 0}");

            if (ReservationState?.SelectedSlots == null || !ReservationState.SelectedSlots.Any())
            {
                Console.WriteLine("No slots to reserve!");
                errorMessage = "Seçili saat bulunamadı.";
                return;
            }

            var result = await ReservationService.AddReservationAsync(ReservationState);

            if (!string.IsNullOrEmpty(result))
            {
                MessageService.Success("Rezervasyonunuz başarıyla oluşturuldu!");

                Navigation.NavigateTo($"/reservation-confirmed/{result}");
            }
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            Console.WriteLine($"Reservation error: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = "Rezervasyon oluşturulurken bir hata oluştu. Lütfen tekrar deneyin.";
            Console.WriteLine($"Unexpected error confirming reservation: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }


    private void GoBack()
    {
        Navigation.NavigateTo("/user/meetingRooms");
    }
}
