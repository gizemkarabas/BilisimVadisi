<div class="reservation-panel">
	<div class="reservation-panel-header">Lütfen Tarihi Seçin</div>
	<div class="weekly-no-bg" style="background:unset">
		<WeeklyDayPicker @bind-SelectedDate="SelectedDateItem" />
	</div>


	<Row Gutter="16" Style="margin-top: 15px;">
		@if (Rooms.Count == 0)
		{
			<AntDesign.Col Span="24">
				<Alert Message="Bu tarihte gösterilecek oda bulunamadı." Type="@AlertType.Info" ShowIcon="true" />
			</AntDesign.Col>
		}
		else
		{
			@foreach (var room in Rooms)
			{
				<AntDesign.Col Xs="24" Sm="24" Md="12" Lg="8" Xl="6">
					<div @onclick="@(() => NavigateToReservation(room))">
                        <RoomCard RoomName="@room.Name" Location="@room.Location" OccupancyRate="room.OccupancyRate" IsAvailable = "room.IsAvailable"/>
					</div>
				</AntDesign.Col>
			}
		}
	</Row>
</div>
<style>
	.unavailable-room {
		opacity: 0.7;
		cursor: not-allowed;
	}

	.available-room {
		cursor: pointer;
	}
</style>

@code {
	private List<MeetingRoomDto> Rooms = new();
	private DateTime _selectedDate = DateTime.Today;
	private DateTime TodayDate = DateTime.Today;
	private string? UserIdFromQuery;

	private DateItem SelectedDateItem
	{
		get => new DateItem(
			SelectedDate == DateTime.Today ? "Bugün" :
			SelectedDate == DateTime.Today.AddDays(1) ? "Yarın" :
			SelectedDate.ToString("dd.MM.yyyy dddd", new System.Globalization.CultureInfo("tr-TR")),
			SelectedDate);
		set
		{
			if (SelectedDate != value.Date)
			{
				SelectedDate = value.Date;
			}
		}
	}

	private DateTime SelectedDate
	{
		get => _selectedDate;
		set
		{
			_selectedDate = value;
			InvokeAsync(LoadRooms);
		}
	}

	protected override async Task OnInitializedAsync()
	{
		// Read userId from query string if present
		var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
		if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("userId", out var userId))
		{
			UserIdFromQuery = userId.ToString();
		}
		await LoadRooms();
	}

	private async Task LoadRooms()
	{
		try
		{
			Rooms.Clear();
			Rooms = await RoomService.GetAllRoomsWithOccupancyAsync(SelectedDate);
			await InvokeAsync(StateHasChanged);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error in LoadRooms: {ex.Message}");
		}
	}

	private string GetStatusColor(bool available) => available ? "green" : "red";

	private void NavigateToReservation(MeetingRoomDto room)
	{
		if (!room.IsAvailable) return;

		var dateStr = SelectedDate.ToString("yyyy-MM-dd");
		var url = $"/user/reservationForm?roomId={room.Id}&date={dateStr}";
		if (!string.IsNullOrEmpty(UserIdFromQuery))
		{
			url += $"&userId={UserIdFromQuery}";
		}
		Navigation.NavigateTo(url);
	}

	private bool DisablePastDates(DateTime date) => date < DateTime.Today;
}
