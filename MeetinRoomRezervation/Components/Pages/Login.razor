@page "/"
@using Blazored.FluentValidation
@using MeetinRoomRezervation.Components.Layout
@using MeetinRoomRezervation.Data
@using MeetinRoomRezervation.Services
@using System.Security.Claims
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JSRuntime

<style>
	.container {
		font-family: 'Poppins', sans-serif !important;
		font-weight: 600;
	}
</style>

<div class="container"  >
	<div class="container-items">
		<Card Style="border-color:white">
			
			<div class="head-title">Giriş Yap</div>

			@if (!string.IsNullOrEmpty(ErrorMessage))
			{
				<Alert Message="@ErrorMessage" Type="@AlertType.Error" ShowIcon="true" />
			}

			<Form Model="@LoginModel" OnFinish="HandleLogin" Layout="@FormLayout.Vertical">
				<FormItem Label="E-posta">
					<Input Style="height:56px;border:1px solid; border-color:#79747E; border-radius:4px;" @bind-Value="@LoginModel.Email" Placeholder="E-posta Adresinizi Giriniz" />
				</FormItem>

				<FormItem Label="Şifre">
			
					<InputPassword  @bind-Value="@LoginModel.Password" Placeholder="Şifrenizi Giriniz" />
					<div style="display:flex; justify-content: flex-end;">
					<Button Type="@ButtonType.Link"
						Style="width:115px; justify-self:end; align-self:end; color:#FF8682; font-size:14px;font-weight:500; margin-top: 10px;margin-bottom: 10px; margin-right:30px"
						OnClick="@(() => Navigation.NavigateTo("/forgot-password"))" Block>
						Şifremi Unuttum
					</Button>
					</div>
				
					<Button Type="@ButtonType.Primary" HtmlType="submit"
							Style="background-color: #515def;
							height:48px;
							border-radius:4px;
                           color: #fff;
                           margin-top: 10px;
                           font-size: 14px;
                           font-weight: 600 " Block>
						Giriş Yap
					</Button>
				</FormItem>

				

			</Form>

		</Card>
	</div>
	<div class="image-panel">
	<div class="image">
		<Image width={120} src="/W-Home-Hand.png" alt="Travelwise Logo" Preview="false" />
	</div>
	</div>
</div>

@code {
	private LoginInputModel LoginModel = new();
	private bool IsLoading = false;
	private string ErrorMessage = "";
	private bool hasRendered = false;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && !hasRendered)
		{
			hasRendered = true;
			await CheckExistingAuthentication();
		}
	}

	private async Task CheckExistingAuthentication()
	{
		try
		{
			var authState = await AuthProvider.GetAuthenticationStateAsync();
			if (authState.User.Identity?.IsAuthenticated == true)
			{
				var role = authState.User.FindFirst(ClaimTypes.Role)?.Value;

				if (!string.IsNullOrEmpty(role) && role.ToLower().Contains("admin"))
				{
					Navigation.NavigateTo("/admin/dashboard", true);
				}
				else
				{
					Navigation.NavigateTo("/user/meetingRooms", true);
				}
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error checking existing authentication: {ex.Message}");
		}
	}

	private async Task HandleLogin()
	{
		IsLoading = true;
		ErrorMessage = "";

		try
		{
			var user = await AuthService.LoginAsync(LoginModel);

			if (user != null)
			{
				if (AuthProvider is CustomAuthenticationStateProvider customProvider)
				{
					customProvider.MarkUserAsAuthenticated(user.Email, user.Role.ToString());
				}

				if (user.Role == UserRole.Admin)
				{

					Navigation.NavigateTo("/admin/dashboard");
				}
				else
				{
					Navigation.NavigateTo("/user/meetingRooms");
				}
			}
			else
			{
				ErrorMessage = "Email veya şifre hatalı.";
			}
		}
		catch (Exception ex)
		{
			ErrorMessage = "Giriş yapılırken bir hata oluştu.";
		}
		finally
		{
			IsLoading = false;
		}

	}

	public class LoginInputModel
	{
		public string Email { get; set; }

		public string Password { get; set; }
	}
}
