@page "/user/myreservations"
@using AntDesign
@using MeetinRoomReservation.Constants
@using MeetinRoomRezervation.Components.PartialComponents.Reservations
@using MeetinRoomRezervation.Components.PartialComponents.Shared
@using MeetinRoomRezervation.Constants
@using MeetinRoomRezervation.Models
@using MeetinRoomRezervation.Services.ReservationService
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@inject IReservationService ReservationService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IUserService UserService
<PageTitle>Rezervasyonlarım</PageTitle>
<div class="reservation-panel-buttons">
    <Button Type="@ButtonType.Link"
            OnClick="@(() => Navigation.NavigateTo("/user/meetingRooms"))"
            Style="display: flex;
       justify-content:flex-start;
       width:200px;
       justify-content: center;
       align-items: center;
       padding: 0;
       border-radius: 8px;
       box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
       margin-right: 15px;"
            Block>
        <div class="reservation-button">
            <div class="reservation-button-title">
                Toplantı Odaları
            </div>
        </div>
    </Button>
    <Button Type="@ButtonType.Link"
            OnClick="@(() => Navigation.NavigateTo("/user/myreservations"))"
            Style="display: flex;
       width:200px;
       background-color:#0095ff;
       justify-content: center;
       align-items: center;
       padding: 0;
       border-radius: 8px;
       box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
       margin-bottom: 10px;
       margin-left: 15px;"
            Block>
        <div class="reservation-button" style="margin-left:6px;">
            <div class="active-reservation-button-title">
                Rezervasyonlarım
            </div>
        </div>
    </Button>
</div>

<BackPanel style="background-color:white; box-shadow:none; border:none;">
    <PageHeader Style="background-color: unset;padding:0px" Title="Rezervasyonlarım" />

    @if (isLoading)
    {
        <div style="text-align: center; padding: 50px;">
            <Spin Size="SpinSize.Large" />
            <p>Yükleniyor...</p>
        </div>
    }
    else
    {
        <Tabs DefaultActiveKey="1">
            <TabPane Key="1" Tab="Aktif Rezervasyonlarım" Style="min-width:10vw;">
                @if (FutureReservations.Any())
                {
                    <Row Gutter="16">
                        @foreach (var reservation in FutureReservations)
                        {
                            <AntDesign.Col Xs="24" Sm="24" Md="12" Lg="8" Xl="6">
                                <Card Title="@($"{reservation.StartTime.ToLocalTime().ToString("dd.MM.yyyy dddd", turkishCulture)} - {reservation.StartTime.ToLocalTime():HH:mm} - {reservation.EndTime.ToLocalTime():HH:mm}")"
                                      Class="reservation-card"
                                      Style="margin-bottom: 16px;
                                                         border-radius: 6px;
                                                         background-color: unset;
                                                         color: #333;
                                                         box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);">
                                    <Summary Info="new()
                                             {
                                                 Label1 = StringConstants.Company,
                                                 Label2 = StringConstants.Authorized,
                                                 Label3 = StringConstants.Phone,
                                                 Value1 = currentUser.Company,
                                                 Value2 = reservation.User.CompanyOfficial,
                                                 Value3 = reservation.User.ContactPhone
                                             }" />

                        <Button Type="ButtonType.Primary"
                                OnClick="() => ShowCancelConfirmation(reservation.Id)"
                                Style="margin-top:30px; width: 100%;background-color:unset;color:#A90808; border-color:#A90808;"
                                Loading="@isCancelling">
                            Rezervasyonu İptal Et
                        </Button>
                    </Card>
                </AntDesign.Col>
                                }
                    </Row>
                }
                else
                {
                    <Alert Message="Henüz bir rezervasyonunuz bulunmamaktadır." Type="AlertType.Info" ShowIcon="true" />
                }
            </TabPane>

            <TabPane Key="2" Tab="Geçmiş Rezervasyonlarım" Style="min-width:10vw;">
                @if (PastReservations.Any())
                {
                    <Row Gutter="16">
                        @foreach (var reservation in PastReservations)
                        {
                            <AntDesign.Col Xs="24" Sm="24" Md="12" Lg="8" Xl="6">
                                <Card Title="@($"{reservation.StartTime.ToLocalTime().ToString("dd.MM.yyyy dddd", turkishCulture)} - {reservation.StartTime.ToLocalTime():HH:mm} - {reservation.EndTime.ToLocalTime():HH:mm}")"
                                      Style="margin-bottom: 16px;
                                                                          border-radius: 6px;
                                                                          background-color: unset;
                                                                          color: #666;
                                                                          box-shadow: 0px 2px 6px rgba(0, 0, 0, 0.05);">
                                    <Summary Info="new()
                                             {
                                                 Label1 = StringConstants.Company,
                                                 Label2 = StringConstants.Authorized,
                                                 Label3 = StringConstants.Phone,
                                                 Value1 = currentUser.Company,
                                                 Value2 = reservation.User.CompanyOfficial,
                                                 Value3 = reservation.User.ContactPhone
                                             }" />
                        <Tag Style="width: 100%;
                                                height:33px;
                                                margin-top:30px;
                                                display: flex;
                                                justify-content: center;
                                                align-items: center;
                                                font-size:12px;
                                                font-weight:bold;
                                                color:darkgray;"
                             Color="TagColor.Default">
                            Tamamlandı
                        </Tag>
                    </Card>
                </AntDesign.Col>
                                }
                    </Row>
                }
                else
                {
                    <Alert Message="Geçmiş bir rezervasyonunuz bulunmamaktadır." Type="AlertType.Info" ShowIcon="true" />
                }
            </TabPane>
        </Tabs>
    }
</BackPanel>


@code {
    private static readonly CultureInfo turkishCulture = new CultureInfo("tr-TR");

    private List<ReservationDto> FutureReservations = new();
    private UserDto currentUser;
    private List<ReservationDto> PastReservations = new();
    private bool isLoading = true;
    private bool isCancelling = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadReservations();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading reservations: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadReservations()
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            if (!authState.User.Identity?.IsAuthenticated == true)
            {
                return;
            }

            var allReservations = await ReservationService.GetUserReservationsAsync();

            var user = await ReservationService.GetCurrentUserAsync();
            currentUser = new()
            {
                Company = user.Company,
                CompanyOfficial = user.CompanyOfficial,
                ContactPhone = user.ContactPhone,
                Email = user.Email,
                Id = user.Id,
            };
            var nowUtc = DateTime.UtcNow;

            FutureReservations = allReservations
                .Where(r => r.EndTime > nowUtc)
                .OrderBy(r => r.StartTime)
                .ToList();

            PastReservations = allReservations
                .Where(r => r.EndTime <= nowUtc)
                .OrderByDescending(r => r.StartTime)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in LoadReservations: {ex.Message}");
        }
    }


    private async Task ShowCancelConfirmation(string reservationId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Bu rezervasyonu iptal etmek istediğinizden emin misiniz?");

        if (confirmed)
        {
            await CancelReservation(reservationId);
        }
    }

    private async Task CancelReservation(string reservationId)
    {
        if (string.IsNullOrEmpty(reservationId))
        {
            return;
        }

        isCancelling = true;
        StateHasChanged();

        try
        {
            var success = await ReservationService.DeleteReservationAsync(reservationId);

            if (success)
            {
                await LoadReservations();
            }
            else
            {
                Console.WriteLine("Failed to cancel reservation");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cancelling reservation: {ex.Message}");
        }
        finally
        {
            isCancelling = false;
            StateHasChanged();
        }
    }
}



