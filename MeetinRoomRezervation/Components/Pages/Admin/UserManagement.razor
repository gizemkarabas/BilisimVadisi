@page "/admin/users"
@layout AdminLayout
@using MeetinRoomRezervation.Components.Layout
@using MeetinRoomRezervation.Components.PartialComponents.Shared
@using MeetinRoomRezervation.Models
@inject IReservationService ReservationService
@inject IUserService UserService
@inject IPasswordResetService PasswordResetService
@using AntDesign
@using MeetinRoomRezervation.Services.ReservationService
@inject NavigationManager Navigation
<style>
    .table-wrapper {
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #f0f0f0;
    }

        .table-wrapper .ant-table {
            border: none !important;
            border-radius: 0 !important;
        }

        .table-wrapper .ant-table-container {
            border-radius: 0 !important;
        }

        .table-wrapper .ant-table-thead > tr > th {
            border-top: none !important;
        }

            .table-wrapper .ant-table-thead > tr > th:first-child {
                border-left: none !important;
            }

            .table-wrapper .ant-table-thead > tr > th:last-child {
                border-right: none !important;
            }
</style>
<div class="container">
    <Modal @bind-Visible="@IsCreateModalVisible" Footer="null" Header="null">
        <div class="create-user-panel">
            <Form Style="width:100%; display:flex; flex-direction:column;align-items: flex-start; font-size:16px;"
                  Model="@NewUser">

                <FormItem Label="" Required>
                    <label style="margin-bottom: 8px; font-weight: 600;">Şirket İsmi</label>
                    <Input @bind-Value="@NewUser.Company" Placeholder="Şirket ismini giriniz" MaxLength="100"
                           Style="background-color:#D9D9D9;width:100%; border-radius:6px; height:48px" />
                    @if (string.IsNullOrWhiteSpace(NewUser.Company))
                    {
                        <div style="color: red; font-size: 12px; margin-top: 4px;">Şirket ismi zorunludur.</div>
                    }
                </FormItem>

                <FormItem Label="" Required>
                    <label style="margin-bottom: 8px; font-weight: 600;">Yetkili</label>
                    <Input @bind-Value="@NewUser.CompanyOfficial" Placeholder="Yetkili kişi adını giriniz"
                           Style="background-color:#D9D9D9; border-radius:6px;width:100%;height:48px" />
                    @if (string.IsNullOrWhiteSpace(NewUser.CompanyOfficial))
                    {
                        <div style="color: red; font-size: 12px; margin-top: 4px;">Yetkili kişi zorunludur.</div>
                    }
                </FormItem>

                <FormItem Label="" Required>
                    <label style="margin-bottom: 8px; font-weight: 600;">Telefon</label>
                    <Input @bind-Value="@NewUser.ContactPhone" Placeholder="5XXXXXXXXX" Type="InputType.Tel"
                           MaxLength="10" Style="background-color:#D9D9D9;width:100%; border-radius:6px; height:48px"
                           OnInput="@((e) => ValidatePhoneInput(e.Value?.ToString(), true))" />
                    <div style="font-size: 12px; color: #666; margin-top: 4px;">
                        Format: 5XXXXXXXXX (10 haneli, 5 ile başlamalı)
                    </div>
                </FormItem>

                <FormItem Label="" Required>
                    <label style="margin-bottom: 8px; font-weight: 600;">E-posta</label>
                    <Input @bind-Value="@NewUser.Email" Placeholder="E-posta adresi giriniz" Type="InputType.Email"
                           MaxLength="100" Style="background-color:#D9D9D9;width:100%; border-radius:6px; height:48px"
                           OnInput="@((e) => ValidateEmailInput(e.Value?.ToString()))" />
                </FormItem>

                <FormItem Label="" Required>
                    <label style="margin-bottom: 8px; font-weight: 600;">Aylık Kullanım Hakkı (Saat)</label>
                    <AntDesign.InputNumber Style="background-color:#D9D9D9; border-radius:6px; height:48px; width:100%; display:flex; align-items:center; font-size: 16px"
                                           @bind-Value="NewUser.MonthlyUsageLimit" Min="0" Max="1000" />
                </FormItem>

                <FormItem Label="Bu Ay Kullanıldı">
                    <Typography Style="font-size: 20px;font-weight:bold" Type="TextElementType.Secondary">
                        @NewUser.UsedThisMonth saat
                    </Typography>
                </FormItem>
            </Form>
        </div>
        @if (showCreateFormError)
        {
            <Alert Type="AlertType.Error" ShowIcon="true" Message="Lütfen eksik veya hatalı alanları düzeltin." Description="@(GetCreateFormErrorDescription())" Style="margin-bottom:10px;" />
        }
        <div style="display:flex; justify-content: center;margin-top:15px">
            <Button Style="background-color:#0095FF;border-radius:6px;width:30%;height:48px" Type="ButtonType.Primary"
                    OnClick="CreateUser">
                Kaydet
            </Button>
        </div>
    </Modal>

    <Modal @bind-Visible="@IsEditModalVisible" Footer="null">
        <div class="edit-user-panel">
            <Form Style="gap:8px;  display:flex; flex-direction:column; font-size:16px; " Model="@EditingUser">
                <b>Şirket İsmi</b>
                <Input Style="background-color:#D9D9D9; border-radius:6px; height:48px"
                       @bind-Value="EditingUser.Company" />
                <b>Yetkili</b>
                <Input Style="background-color:#D9D9D9; border-radius:6px; height:48px"
                       @bind-Value="EditingUser.CompanyOfficial" />
                <b>Telefon</b>
                <Input Style="background-color:#D9D9D9; border-radius:6px; height:48px"
                       @bind-Value="EditingUser.ContactPhone" />
                <b>E-posta</b>
                <Input Style="background-color:#D9D9D9; border-radius:6px; height:48px"
                       @bind-Value="EditingUser.Email" />
                <b>Aylık Kullanım Hakkı (Saat)</b>
                <AntDesign.InputNumber Style="background-color:#D9D9D9; border-radius:6px; height:48px; width:40%; display:flex; align-items:center; font-size: 16px "
                                       @bind-Value="EditingUser.MonthlyUsageLimit" />
                <b>Bu Ay Kullanıldı</b>
                <Typography Style="font-size: 20px;font-weight:bold" Type="TextElementType.Secondary">
                    @EditingUser.UsedThisMonth Saat
                </Typography>
            </Form>
        </div>
        <div style="display:flex; justify-content: center;margin-top:15px">
            <Button Style="background-color:#0095FF;border-radius:6px;width:30%;height:48px" Type="ButtonType.Primary"
                    OnClick="UpdateUser">
                Güncelle
            </Button>
        </div>
    </Modal>

    <Modal @bind-Visible="IsReservationModalVisible" Title="Bir Toplantı Ayarla" Footer="null">
        <div style="display:flex; flex-direction:column; gap:16px; min-width:300px;">
            <b>Kullanıcı Seç</b>
            @if (AllUsers != null && AllUsers.Any(u => !string.IsNullOrEmpty(u.Id)))
            {
                <Select TItem="UserDto" TItemValue="string" DataSource="@AllUsers" @bind-Value="SelectedUserId"
                        LabelName="Company" ValueName="Id" Placeholder="Kullanıcı seçiniz" EnableSearch
                        Style="min-width:220px;max-width:320px;">
                </Select>
            }
            else
            {
                <Alert Message="Kullanıcı listesi yüklenemedi veya kullanıcıların Id bilgisi eksik." Type="AlertType.Error"
                       ShowIcon="true" />
            }

            <Button Type="ButtonType.Primary" Disabled="@(string.IsNullOrEmpty(SelectedUserId))"
                    OnClick="GoToReservationForSelectedUser">
                Devam Et
            </Button>
        </div>
    </Modal>
    <div class="dashboard-panel">
        <div class="user-search" style="display:flex;justify-content:center">
            <Input Placeholder="Ara" @bind-Value="searchTerm"
                   Style="width:100%; height:30px; border-radius:10px; background:#fafafa; border:1px solid #e6e6e6; font-size:16px; padding-left:36px; box-sizing:border-box; margin-top:8px;"
                   PrefixIcon="search" OnInput="@(e => OnSearchChanged(e.Value?.ToString() ?? string.Empty))" />
        </div>
        <div class="users-panel">
            <div style="display:flex;justify-content: space-between;align-items: center;">
                <div class="table-header">Kullanıcılar</div>
            </div>
            <div class="table-wrapper">
                @if (IsLoading)
                {
                    <SkeletonTable ColumnCount="7"></SkeletonTable>
                }
                else
                {
                    <Table TItem="UserDto" DataSource="@PagedUsers" Responsive PaginationPosition="bottomRight">
                        <PaginationTemplate>
                            <div style="display: flex; justify-content: flex-end; padding: 16px; background:white">
                                <Pagination Total="@TotalUserCount" PageSize="@PageSize" Current="@CurrentPage"
                                            OnChange="HandlePaginationChange" ShowSizeChanger="true"
                                            PageSizeOptions="@(new int[] { 5, 10, 20, 50 })" />
                            </div>
                        </PaginationTemplate>
                        <ChildContent>
                            <Column TData="string" DataIndex="@nameof(UserDto.Company)" Title="Şirket İsmi" />
                            <Column TData="string" DataIndex="@nameof(UserDto.CompanyOfficial)" Title="Yetkili" />
                            <Column TData="string" Title="Aylık Kalan Haklar">
                                <Template>
                                    @context.UsedThisMonth/@context.MonthlyUsageLimit saat
                                </Template>
                            </Column>
                            <Column TData="string" DataIndex="@nameof(UserDto.Email)" Title="Email" />
                            <Column TData="string" Title="Telefon">
                                <Template>
                                    @(!string.IsNullOrEmpty(context.ContactPhone) ? $"+90{context.ContactPhone}" : "-")
                                </Template>
                            </Column>
                            <Column TData="string" Title="Aktif">
                                <Template>
                                    @if (context.IsActive)
                                    {
                                        <Tag Color="TagColor.Lime" Style="cursor:pointer;"
                                             OnClick="@(() => ToggleStatus(context))">Aktif</Tag>
                                    }
                                    else
                                    {
                                        <Tag Color="TagColor.Red" Style="cursor:pointer;"
                                             OnClick="@(() => ToggleStatus(context))">Pasif</Tag>
                                    }
                                </Template>
                            </Column>
                            <ActionColumn>
                                <Space>
                                    <Button Style="margin-right:4px;margin-bottom:4px" Icon="edit"
                                            Shape="ButtonShape.Circle" OnClick="@(() => EditUser(context))">
                                    </Button>
                                    <Popconfirm Title="Bu kullanıcı silinsin mi?"
                                                OnConfirm="@(() => DeleteUser(context.Id))">
                                        <Button Icon="delete" Shape="ButtonShape.Circle" Danger></Button>
                                    </Popconfirm>
                                </Space>
                            </ActionColumn>
                        </ChildContent>
                    </Table>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<UserDto> AllUsers = new();
    private List<UserDto> PagedUsers = new();
    private string searchTerm = string.Empty;
    private int PageSize = 10;
    private int CurrentPage = 1;
    private int TotalUserCount = 0;
    private bool IsCreateModalVisible = false;
    private UserDto NewUser = new();
    private bool IsEditModalVisible = false;
    private UserDto EditingUser = new();
    private bool IsLoading = true;

    // Validation messages
    private string companyValidationMessage = "Şirket ismi giriniz.";
    private string phoneValidationMessage = "Telefon numarası giriniz.";
    private string editCompanyValidationMessage = "";
    private string editPhoneValidationMessage = "";
    private string emailValidationMessage = string.Empty;
    private string SelectedUserId = string.Empty;
    private bool IsReservationModalVisible = false;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        StateHasChanged();
        await UserService.UpdateMonthlyUsageAsync();
        await LoadUsers();
        _shouldCheckModalQuery = true;
        IsLoading = false;
        StateHasChanged();
    }

    private bool _shouldCheckModalQuery = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldCheckModalQuery)
        {
            _shouldCheckModalQuery = false;
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            bool opened = false;
            if (query.Get("createModal") == "true")
            {
                Console.WriteLine("OpenCreateModal() called from OnAfterRenderAsync due to query string.");
                OpenCreateModal();
                opened = true;
            }
            if (query.Get("reservationModal") == "true")
            {
                ShowReservationModal();
                opened = true;
            }
            if (opened)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void OpenCreateModal()
    {
        IsCreateModalVisible = true;
        NewUser = new UserDto();
        companyValidationMessage = string.Empty;
        phoneValidationMessage = string.Empty;
        emailValidationMessage = string.Empty;
        ValidateEmailInput(NewUser.Email);
        // Only call StateHasChanged if not already in a render cycle
        // StateHasChanged();
    }

    private void ShowReservationModal()
    {
        SelectedUserId = string.Empty;
        IsReservationModalVisible = true;
    }
    private void GoToReservationForSelectedUser()
    {
        if (!string.IsNullOrEmpty(SelectedUserId))
        {
            IsReservationModalVisible = false;
            Navigation.NavigateTo($"/user/meetingRooms?userId={SelectedUserId}");
        }
    }

    private void CancelCreate()
    {
        IsCreateModalVisible = false;
        NewUser = new();
        companyValidationMessage = "";
        phoneValidationMessage = "";
        emailValidationMessage = string.Empty;
    }

    private bool showCreateFormError = false;
    private async Task CreateUser()
    {
        // Tüm validasyonları tetikle
        ValidateCompanyName(NewUser.Company, true);
        ValidatePhoneNumber(NewUser.ContactPhone, true);
        ValidateEmailInput(NewUser.Email);
        StateHasChanged();

        if (!IsCreateFormValid())
        {
            showCreateFormError = true;
            return;
        }
        // Form geçerliyse uyarı otomatik kapanmalı
        showCreateFormError = false;
        try
        {
            await UserService.AddUserAsync(NewUser);
            // Kullanıcı başarıyla eklendikten sonra, veritabanından tekrar çekip e-posta adresiyle şifre sıfırlama maili gönder
            var createdUser = (await UserService.GetAllUsersAsync()).FirstOrDefault(u => u.Email == NewUser.Email);
            if (createdUser != null && !string.IsNullOrWhiteSpace(createdUser.Email))
            {
                try
                {
                    await Task.Delay(200);
                    await PasswordResetService.SendPasswordResetEmailAsync(createdUser.Email);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Şifre sıfırlama maili gönderilemedi: {ex.Message}");
                }
            }
            await LoadUsers();
            CancelCreate();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating user: {ex.Message}");
        }
    }
    private string GetCreateFormErrorDescription()
    {
        var errors = new List<string>();
        if (string.IsNullOrWhiteSpace(NewUser.Company)) errors.Add("Şirket ismi zorunludur.");
        if (string.IsNullOrWhiteSpace(NewUser.CompanyOfficial)) errors.Add("Yetkili kişi zorunludur.");
        if (string.IsNullOrWhiteSpace(NewUser.ContactPhone)) errors.Add("Telefon zorunludur.");
        else if (NewUser.ContactPhone.Length != 10 || !NewUser.ContactPhone.StartsWith("5")) errors.Add("Telefon 5 ile başlamalı ve 10 haneli olmalı.");
        if (string.IsNullOrWhiteSpace(NewUser.Email)) errors.Add("E-posta zorunludur.");
        else if (!string.IsNullOrEmpty(emailValidationMessage)) errors.Add(emailValidationMessage);
        if (NewUser.MonthlyUsageLimit <= 0) errors.Add("Aylık kullanım hakkı zorunludur.");
        return string.Join(" ", errors);
    }

    private async Task LoadUsers()
    {
        try
        {
            IsLoading = true;
            StateHasChanged();
            AllUsers = await UserService.GetAllUsersAsync();
            TotalUserCount = AllUsers.Count;
            ApplySearchAndPage();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading users: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void OnSearchChanged(string value)
    {
        searchTerm = value ?? string.Empty;

        IsLoading = true;
        StateHasChanged();

        Task.Run(async () =>
        {
            await Task.Delay(200);
            ApplySearchAndPage();
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void ApplySearchAndPage()
    {
        IEnumerable<UserDto> filtered = AllUsers;
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim().ToLowerInvariant();
            filtered = filtered.Where(u =>
            (!string.IsNullOrEmpty(u.Company) && u.Company.ToLowerInvariant().Contains(term)) ||
            (!string.IsNullOrEmpty(u.CompanyOfficial) && u.CompanyOfficial.ToLowerInvariant().Contains(term)) ||
            (!string.IsNullOrEmpty(u.Email) && u.Email.ToLowerInvariant().Contains(term)) ||
            (!string.IsNullOrEmpty(u.ContactPhone) && u.ContactPhone.Contains(term))
            );
        }
        TotalUserCount = filtered.Count();
        int totalPages = (int)Math.Ceiling((double)TotalUserCount / PageSize);
        if (CurrentPage > totalPages) CurrentPage = totalPages > 0 ? totalPages : 1;
        PagedUsers = filtered
        .OrderByDescending(r => r.Id)
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize)
        .ToList();
        StateHasChanged();
    }

    private void LoadPage()
    {
        ApplySearchAndPage();
    }

    private async Task ToggleStatus(UserDto user)
    {
        IsLoading = true;
        StateHasChanged();

        user.IsActive = !user.IsActive;
        await UserService.UpdateUserStatusAsync(user.Id, user.IsActive);
        await LoadUsers();
    }

    private async Task DeleteUser(string id)
    {
        IsLoading = true;
        StateHasChanged();

        await UserService.DeleteUserAsync(id);
        await LoadUsers();
    }

    private void HandlePaginationChange(PaginationEventArgs args)
    {
        CurrentPage = args.Page;

        if (args.PageSize != PageSize)
        {
            PageSize = args.PageSize;
        }

        IsLoading = true;
        StateHasChanged();

        LoadPage();

        Task.Run(async () =>
        {
            await Task.Delay(300);
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void EditUser(UserDto user)
    {
        EditingUser = new UserDto
        {
            Id = user.Id,
            Email = user.Email,
            FirstName = user.FirstName,
            LastName = user.LastName,
            Company = user.Company,
            CompanyOfficial = user.CompanyOfficial,
            ContactPhone = user.ContactPhone,
            MonthlyUsageLimit = user.MonthlyUsageLimit,
            UsedThisMonth = user.UsedThisMonth,
            IsActive = user.IsActive
        };

        // Clear validation messages
        editCompanyValidationMessage = "";
        editPhoneValidationMessage = "";

        IsEditModalVisible = true;
        StateHasChanged();
    }

    private void CancelEdit()
    {
        IsEditModalVisible = false;
        EditingUser = new();
        editCompanyValidationMessage = "";
        editPhoneValidationMessage = "";
    }

    private void OnMonthlyLimitChange(int newValue)
    {
        EditingUser.MonthlyUsageLimit = newValue;
        StateHasChanged();
    }

    private int GetRemainingHours()
    {
        return Math.Max(0, EditingUser.MonthlyUsageLimit - EditingUser.UsedThisMonth);
    }

    private string GetRemainingHoursColor()
    {
        var remaining = GetRemainingHours();
        if (remaining <= 0) return "#ff4d4f"; // Kırmızı
        if (remaining <= 5) return "#faad14"; // Sarı
        return "#52c41a"; // Yeşil
    }

    private async Task UpdateUser()
    {
        IsLoading = true;
        StateHasChanged();

        await UserService.UpdateUserAsync(EditingUser);
        await LoadUsers();
        IsEditModalVisible = false;
    }

    // Validation Methods
    private bool ValidateCompanyName(string company, bool isCreate = true)
    {
        var message = "";
        var isValid = true;

        if (string.IsNullOrWhiteSpace(company))
        {
            message = "Şirket ismi zorunludur.";
            isValid = false;
        }
        else if (company.Length < 2)
        {
            message = "Şirket ismi en az 2 karakter olmalıdır.";
            isValid = false;
        }
        else if (company.Length > 100)
        {
            message = "Şirket ismi en fazla 100 karakter olabilir.";
            isValid = false;
        }

        if (isCreate)
        {
            companyValidationMessage = message;
            showCreateFormError = false;
        }
        else
            editCompanyValidationMessage = message;

        return isValid;
    }

    private bool ValidatePhoneNumber(string phone, bool isCreate = true)
    {
        var message = "";
        var isValid = true;

        if (string.IsNullOrWhiteSpace(phone))
        {
            message = "Telefon numarası zorunludur.";
            isValid = false;
        }
        else if (phone.Length != 10)
        {
            message = "Telefon numarası 10 haneli olmalıdır.";
            isValid = false;
        }
        else if (!phone.StartsWith("5"))
        {
            message = "Telefon numarası 5 ile başlamalıdır.";
            isValid = false;
        }
        else if (!phone.All(char.IsDigit))
        {
            message = "Telefon numarası sadece rakam içermelidir.";
            isValid = false;
        }

        if (isCreate)
            phoneValidationMessage = message;
        else
            editPhoneValidationMessage = message;

        return isValid;
    }

    private void ValidatePhoneInput(string phone, bool isCreate)
    {
        ValidatePhoneNumber(phone, isCreate);
        showCreateFormError = false;
        StateHasChanged();
    }

    private void ValidateEmailInput(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            emailValidationMessage = "E-posta adresi zorunludur.";
            showCreateFormError = false;
            return;
        }
        if (!IsValidEmail(email))
        {
            emailValidationMessage = "Geçerli bir e-posta adresi giriniz.";
            showCreateFormError = false;
            return;
        }
        emailValidationMessage = string.Empty;
        showCreateFormError = false;
    }

    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        // '@' ve '.' karakteri yoksa MailAddress kontrolü yapma
        if (!email.Contains("@") || !email.Contains(".")) return false;
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }

    private bool IsCreateFormValid()
    {
        return string.IsNullOrEmpty(companyValidationMessage)
        && string.IsNullOrEmpty(phoneValidationMessage)
        && string.IsNullOrEmpty(emailValidationMessage)
        && !string.IsNullOrWhiteSpace(NewUser.Company)
        && !string.IsNullOrWhiteSpace(NewUser.CompanyOfficial)
        && !string.IsNullOrWhiteSpace(NewUser.ContactPhone)
        && NewUser.MonthlyUsageLimit > 0;
    }

    private bool IsEditFormValid()
    {
        var companyValid = ValidateCompanyName(EditingUser.Company, false);
        var phoneValid = ValidatePhoneNumber(EditingUser.ContactPhone, false);
        var limitValid = EditingUser.MonthlyUsageLimit >= EditingUser.UsedThisMonth;

        return companyValid && phoneValid && limitValid;
    }
}
