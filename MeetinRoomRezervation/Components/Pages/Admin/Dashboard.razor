@page "/admin/dashboard"
@layout AdminLayout
@using AntDesign.TableModels
@using MeetinRoomRezervation.Components.Layout
@using MeetinRoomRezervation.Components.PartialComponents.Admin
@using MeetinRoomRezervation.Components.PartialComponents.Shared
@using MeetinRoomRezervation.Constants
@using MeetinRoomRezervation.Models
@using MeetinRoomRezervation.Services.Services
@inject IReservationService ReservationService
@inject IRoomService RoomService
@inject IUserService UserService
@using AntDesign
@using MeetinRoomRezervation.Services.ReservationService
@using System.Globalization
@inject NavigationManager Navigation
<style>
    .table-wrapper {
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #f0f0f0;
    }

        .table-wrapper .ant-table {
            border: none !important;
            border-radius: 0 !important;
        }

        .table-wrapper .ant-table-container {
            border-radius: 0 !important;
        }

        .table-wrapper .ant-table-thead > tr > th {
            border-top: none !important;
        }

            .table-wrapper .ant-table-thead > tr > th:first-child {
                border-left: none !important;
            }

            .table-wrapper .ant-table-thead > tr > th:last-child {
                border-right: none !important;
            }
</style>
<AuthorizeView Roles="Admin" Context="authContext">
    <Authorized Context="authContext">
        <div class="container">
            <div class="dashboard-panel">
                <GridRow Gutter="(16, 16)" Style="align-items: stretch;">
                    <GridCol xs="12" md="6" lg="6">
                        <div class="count-panel">
                            <div class="count-panel-title">Toplam Toplantı Odası</div>
                            <div class="count-panel-value">@TotalRoomCount</div>
                        </div>
                    </GridCol>
                    <GridCol xs="12" md="6" lg="6">
                        <div class="count-panel">
                            <div class="count-panel-title">Toplam Kullanıcı Sayısı</div>
                            <div class="count-panel-value">@TotalUserCount</div>
                        </div>
                    </GridCol>
                    <GridCol xs="12" md="6" lg="6">
                        <div class="count-panel">
                            <div class="count-panel-title">Bugünkü Doluluk</div>
                            <div class="count-panel-value">@TodayOccupancy%</div>
                        </div>
                    </GridCol>
                    <GridCol xs="12" md="6" lg="6">
                        <div class="count-panel">
                            <div class="count-panel-title">Haftalık Doluluk Oranı</div>
                            <div class="count-panel-value">@WeeklyOccupancy%</div>
                        </div>
                    </GridCol>
                </GridRow>
                <div class="last-reservation-panel">
                    <div class="last-reservation-panel-header">Son Rezervasyonlar</div>
                    @if (IsLoading)
                    {
                        <div class="table-wrapper">
                            <SkeletonTable RowCount="10" ColumnCount="8" />
                        </div>
                    }
                    else
                    {
                        <div class="table-wrapper">
                            <Table TItem="ReservationDto" DataSource="@PagedReservations" Responsive
                                   PaginationPosition="bottomRight">
                                <PaginationTemplate>
                                    <div style="display: flex; justify-content: flex-end; padding: 16px; background:white">
                                        <Pagination Total="@TotalReservationCount" PageSize="@PageSize" Current="@CurrentPage"
                                                    OnChange="HandlePaginationChange" ShowSizeChanger="true"
                                                    PageSizeOptions="@(new int[] { 5, 10, 20, 50 })" />
                                    </div>
                                </PaginationTemplate>
                                <ChildContent>
                                    <Column TData="string" DataIndex="@nameof(ReservationDto.Location)" Title="Konum"></Column>
                                    <Column TData="string" DataIndex="@nameof(ReservationDto.RoomName)" Title="Salon"></Column>
                                    <Column TData="string" Title="Tarih">
                                        <Template>
                                            @context.StartTime.ToLocalTime().ToString("dd MMMM yyyy dddd", turkishCulture)
                                        </Template>
                                    </Column>
                                    <Column TData="string" Title="Saat">
                                        <Template>
                                            <Tag Color="TagColor.Blue">
                                                @context.StartTime.ToLocalTime().ToString("HH:mm") -
                                                @context.EndTime.ToLocalTime().ToString("HH:mm")
                                            </Tag>
                                        </Template>
                                    </Column>
                                    <Column TData="string" Title="Şirket">
                                        <Template>
                                            @(context?.User?.Company ?? StringConstants.Dash)
                                        </Template>
                                    </Column>
                                    <Column TData="string" Title="Yetkili">
                                        <Template>
                                            @(context?.User?.CompanyOfficial ?? StringConstants.Dash)
                                        </Template>
                                    </Column>
                                    <Column TData="string" Title="Telefon">
                                        <Template>
                                            @(context?.User?.ContactPhone ?? StringConstants.Dash)
                                        </Template>
                                    </Column>
                                    <ActionColumn>
                                        <Space>
                        @* <Button Style="margin-right:4px;" Icon="edit" Shape="ButtonShape.Circle"
                            OnClick="@(() => OpenEditModal(context))" /> *@
                                            <Button Icon="delete" Shape="ButtonShape.Circle" Danger
                                                    OnClick="@(() => ConfirmDelete(context))" />
                                        </Space>
                                    </ActionColumn>
                                </ChildContent>
                            </Table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

<Modal Title="Rezervasyonu Düzenle" @bind-Visible="@IsEditModalVisible" OnOk="SubmitEdit" OnCancel="@CloseEditModal">

    @if (EditModel != null)
    {
        <Form Model="@EditModel">
            <FormItem Label="Salon">
                <Input @bind-Value="EditModel.Room.Name" />
            </FormItem>
            <FormItem Label="Konum">
                <Input @bind-Value="EditModel.Location" />
            </FormItem>
            <FormItem Label="Tarih">
                <DatePicker @bind-Value="EditModel.StartTime" />
            </FormItem>
            <FormItem Label="Saat (başlangıç)">
                <TimePicker @bind-Value="EditModel.StartTime" />
            </FormItem>
            <FormItem Label="Saat (bitiş)">
                <TimePicker @bind-Value="EditModel.EndTime" />
            </FormItem>
        </Form>
    }
</Modal>
<Modal Title="Rezervasyon Detayı" @bind-Visible="@IsDetailModalVisible" OnOk="@CloseDetailModal"
       OnCancel="@CloseDetailModal">

    @if (SelectedReservation != null)
    {
        <Descriptions Title="Bilgiler" Column="1" Size="DescriptionsSize.Small">
            <DescriptionsItem Label="Salon">
                @(SelectedReservation.Room != null ? SelectedReservation.Room.Name : "-")
            </DescriptionsItem>
            <DescriptionsItem Label="Konum">@SelectedReservation.Location</DescriptionsItem>
            <DescriptionsItem Label="Tarih">
                @SelectedReservation.StartTime.ToLocalTime().ToString("dd MMMM yyyy dddd", new
                System.Globalization.CultureInfo("tr-TR"))
        </DescriptionsItem>
        <DescriptionsItem Label="Saat">
            @SelectedReservation.StartTime.ToLocalTime().ToString("HH:mm") -
            @SelectedReservation.EndTime.ToLocalTime().ToString("HH:mm")
        </DescriptionsItem>
        <DescriptionsItem Label="Şirket">
            @(SelectedReservation.User != null ? SelectedReservation.User.Company : "-")
        </DescriptionsItem>
        <DescriptionsItem Label="Yetkili">
            @(SelectedReservation.User != null ? SelectedReservation.User.CompanyOfficial
                        : "-")
                          </DescriptionsItem>
                          <DescriptionsItem Label="Telefon">
            @(SelectedReservation.User != null ? SelectedReservation.User.ContactPhone :
                        "-")
        </DescriptionsItem>
    </Descriptions>
        }
</Modal>
<Modal Title="Rezervasyonu Sil" @bind-Visible="@IsDeleteConfirmVisible" OnOk="DeleteReservation" OnCancel="CancelDelete"
       OkText=@okButtonText CancelText=@cancelButtonText OkType="ButtonType.Primary">

    <p>@ReservationToDelete?.Room.Name rezervasyonunu silmek istediğinize emin misiniz?</p>
</Modal>

@code {
    private bool IsLoading = true;
    private int TotalRoomCount = 0;
    private int TotalUserCount = 0;
    private double TodayOccupancy = 0;
    private double WeeklyOccupancy = 0;
    private bool IsDetailModalVisible = false;
    private ReservationDto? SelectedReservation;
    private bool IsEditModalVisible = false;
    private ReservationDto? EditModel;
    private bool IsDeleteConfirmVisible = false;
    private ReservationDto? ReservationToDelete;
    private string okButtonText = "Evet, sil";
    private string cancelButtonText = "Vazgeç";
    private int PageSize = 10;
    private int CurrentPage = 1;
    private int TotalReservationCount => FilteredReservations.Count;
    private List<ReservationDto> AllReservations = new();
    private List<ReservationDto> PagedReservations = new();
    private List<ReservationDto> LastReservations = new();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredReservations.Count / PageSize));
    private List<ReservationDto> FilteredReservations => AllReservations.Where(x => x.StartTime > DateTime.UtcNow).OrderBy(r
    => r.StartTime).ToList();
    string[] columns = ["Location"];
    private static readonly CultureInfo turkishCulture = new CultureInfo("tr-TR");

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        StateHasChanged();

        var reservations = await ReservationService.GetAllReservationsAsync();
        // Tüm odaları ve kullanıcıları başta çek
        var allRooms = await RoomService.GetAllRoomsAsync();
        var allUsers = await UserService.GetAllUsersAsync();
        FillReservationDetailsFromCache(reservations, allRooms, allUsers);
        LoadDashboardDataAsync(reservations, allRooms, allUsers);
        LoadPage();

        IsLoading = false;
        StateHasChanged();
    }


    private void FillReservationDetailsFromCache(List<ReservationDto> reservations, List<MeetingRoomDto> allRooms,
    List<UserDto> allUsers)
    {
        var roomDict = allRooms.ToDictionary(r => r.Id, r => r);
        var userDict = allUsers.ToDictionary(u => u.Id, u => u);
        foreach (var res in reservations)
        {
            if (res.Room == null && !string.IsNullOrEmpty(res.RoomId) && roomDict.TryGetValue(res.RoomId, out var room))
                res.Room = room;
            if (res.User == null && !string.IsNullOrEmpty(res.UserId) && userDict.TryGetValue(res.UserId, out var user))
                res.User = user;
        }
    }


    private void LoadDashboardDataAsync(List<ReservationDto> reservations, List<MeetingRoomDto> allRooms, List<UserDto>
    allUsers)
    {
        LastReservations = reservations
        .Where(r => r.StartTime.Date >= DateTime.UtcNow)
        .OrderBy(r => r.StartTime)
        .Take(10)
        .ToList();

        TotalRoomCount = allRooms.Count;
        TotalUserCount = allUsers.Count;

        var today = DateTime.Today;
        var tomorrow = today.AddDays(1);
        var todayReservations = reservations
        .Where(r => r.StartTime >= today && r.StartTime < tomorrow)
        .ToList();

        TodayOccupancy = CalculateOccupancyPercentage(todayReservations, allRooms.Count);

        var weekStart = DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek);
        var weekEnd = weekStart.AddDays(7);
        var weekReservations = reservations
        .Where(r => r.StartTime >= weekStart && r.StartTime < weekEnd)
        .ToList();

        WeeklyOccupancy = CalculateOccupancyPercentage(weekReservations, allRooms.Count * 7);

        AllReservations = reservations;
    }

    private double CalculateOccupancyPercentage(List<ReservationDto> reservations, int totalRoomDays)
    {
        double reservedHours = reservations.Count; // 1 saatlik rezervasyon varsayıyoruz
        double totalHours = totalRoomDays * 24;
        if (totalHours == 0) return 0;

        return Math.Round((reservedHours / totalHours) * 100, 2);
    }


    private void ShowDetails(ReservationDto res)
    {
        SelectedReservation = res;
        IsDetailModalVisible = true;
    }

    private void CloseDetailModal()
    {
        IsDetailModalVisible = false;
        SelectedReservation = null;
    }

    private void OpenEditModal(ReservationDto res)
    {
        EditModel = new ReservationDto
        {
            Id = res.Id,
            Room = res.Room,
            Location = res.Location,
            StartTime = res.StartTime,
            EndTime = res.EndTime,
            User = res.User,
        };

        IsEditModalVisible = true;
    }

    private void CloseEditModal()
    {
        IsEditModalVisible = false;
        EditModel = null;
    }

    private async Task SubmitEdit()
    {
        if (EditModel is not null)
        {
            await ReservationService.UpdateReservationAsync(EditModel);
            await RefreshReservations();
            CloseEditModal();
        }
    }

    private void ConfirmDelete(ReservationDto res)
    {
        ReservationToDelete = res;
        IsDeleteConfirmVisible = true;
    }

    private void CancelDelete()
    {
        ReservationToDelete = null;
        IsDeleteConfirmVisible = false;
    }

    private async Task DeleteReservation()
    {
        if (ReservationToDelete is not null)
        {
            await ReservationService.AdminDeleteReservationAsync(ReservationToDelete.Id!);
            await RefreshReservations();
            CancelDelete();
        }
    }


    private async Task RefreshReservations()
    {
        IsLoading = true;
        StateHasChanged();

        var reservations = await ReservationService.GetAllReservationsAsync();
        var allRooms = await RoomService.GetAllRoomsAsync();
        var allUsers = await UserService.GetAllUsersAsync();
        FillReservationDetailsFromCache(reservations, allRooms, allUsers);
        AllReservations = reservations;
    // TotalReservationCount artık sadece getter, atama kaldırıldı.
        LoadPage();

        IsLoading = false;
        StateHasChanged();
    }

    private void HandlePageIndexChange(PaginationEventArgs args)
    {
        CurrentPage = args.Page;
        LoadPage();
    }

    private void HandlePageSizeChange(PaginationEventArgs args)
    {
        PageSize = args.PageSize;
        CurrentPage = 1;
        LoadPage();
    }

    private void LoadPage()
    {
        var filtered = FilteredReservations;
        int totalPages = Math.Max(1, (int)Math.Ceiling((double)filtered.Count / PageSize));
        if (CurrentPage > totalPages) CurrentPage = totalPages;
        if (CurrentPage < 1) CurrentPage = 1;
        PagedReservations = filtered
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }


    private async Task OnPageChanged(PaginationEventArgs args)
    {
        CurrentPage = args.Page;
        LoadPage();
        await Task.CompletedTask;
    }

    private void OnPageSizeChanged(int pageSize)
    {
        PageSize = pageSize;
        CurrentPage = 1;
        LoadPage();
    }

    private void HandleTableChange(QueryModel<ReservationDto> queryModel)
    {
        CurrentPage = queryModel.PageIndex;

        if (PageSize != queryModel.PageSize)
        {
            PageSize = queryModel.PageSize;
            CurrentPage = 1;
        }

        LoadPage();
    }

    private void HandlePaginationChange(PaginationEventArgs args)
    {
        if (args.PageSize != PageSize)
        {
            PageSize = args.PageSize;
            CurrentPage = 1;
        }
        else
        {
            CurrentPage = args.Page;
        }
        LoadPage();
        StateHasChanged();
    }

}
